# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8202
RUST_LOG=info

# Vault is authoritative when these connection settings are present.
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN=hvs...
VAULT_SECRET_PATH=secret/expense-tracker-be-local

# Offline fallbacks (used only when Vault is not configured)
SURREAL_DB_URL=ws://localhost:8000
SURREAL_DB_USER=root
SURREAL_DB_PASS=root
SURREAL_DB_NS=expense_tracker
SURREAL_DB_DB=expense_tracker
DATABASE_URL=postgresql://user:password@localhost:5432/expense_tracker_auth_dev
FRONTEND_URL=http://localhost:3202
